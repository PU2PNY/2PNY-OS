[Unit]
Description=PU2PNY-OS local MQTT broker
After=local-fs.target
Before=2pny-mmdvmhost.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=mosquitto
Group=mosquitto
ExecStart=/usr/sbin/mosquitto -c /etc/mosquitto/2pny-local.conf
Restart=on-failure
RestartSec=1
TimeoutStartSec=10
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=48M
TasksMax=32

[Install]
WantedBy=multi-user.target
