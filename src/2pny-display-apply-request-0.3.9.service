[Unit]
Description=PU2PNY privileged display apply request
After=2pny-mmdvmhost.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/2pny-display-apply-request
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/run/2pny /var/lib/2pny /etc/systemd/system
