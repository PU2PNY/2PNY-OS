# USB/UART/DRM/input hotplug only schedules a non-destructive detector.
ACTION=="add|change", SUBSYSTEM=="tty", TAG+="systemd", ENV{SYSTEMD_WANTS}+="2pny-display-detect.service"
ACTION=="add|change", SUBSYSTEM=="drm", TAG+="systemd", ENV{SYSTEMD_WANTS}+="2pny-display-detect.service"
ACTION=="add|change", SUBSYSTEM=="input", TAG+="systemd", ENV{SYSTEMD_WANTS}+="2pny-display-detect.service"
