#!/bin/bash
set -euo pipefail

CONFIG=/etc/2pny/mmdvm/MMDVM-Host.ini
STATE=/var/lib/2pny
BACKUPS="$STATE/backups/rf"
LOCK=/run/2pny-rf-apply.lock
SERVICE=2pny-mmdvmhost.service

usage() {
  echo "usage: 2pny-rf-apply RX_HZ TX_HZ RX_OFFSET_HZ TX_OFFSET_HZ DUPLEX MODEM_PORT CALLSIGN DMR_ID" >&2
  exit 2
}

[[ $EUID -eq 0 ]] || { echo "root required" >&2; exit 1; }
[[ $# -eq 8 ]] || usage

RX="$1"; TX="$2"; RXOFF="$3"; TXOFF="$4"; DUPLEX="$5"; PORT="$6"; CALLSIGN="${7^^}"; DMRID="$8"

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_int() { [[ "$1" =~ ^-?[0-9]+$ ]]; }

is_uint "$RX" && is_uint "$TX" && is_int "$RXOFF" && is_int "$TXOFF" && is_uint "$DMRID" || {
  echo "invalid numeric RF value" >&2; exit 2;
}

# Hardware sanity limits only; these are not a regulatory band-plan decision.
(( RX >= 100000000 && RX <= 1000000000 )) || { echo "RX frequency outside 100 MHz..1 GHz hardware safety envelope" >&2; exit 2; }
(( TX >= 100000000 && TX <= 1000000000 )) || { echo "TX frequency outside 100 MHz..1 GHz hardware safety envelope" >&2; exit 2; }
(( RXOFF >= -10000000 && RXOFF <= 10000000 )) || { echo "RX offset outside +/-10 MHz" >&2; exit 2; }
(( TXOFF >= -10000000 && TXOFF <= 10000000 )) || { echo "TX offset outside +/-10 MHz" >&2; exit 2; }
[[ "$DUPLEX" == 0 || "$DUPLEX" == 1 ]] || { echo "duplex must be 0 or 1" >&2; exit 2; }
[[ "$CALLSIGN" =~ ^[A-Z0-9/-]{3,16}$ ]] || { echo "invalid callsign" >&2; exit 2; }
(( DMRID >= 1 && DMRID <= 999999999 )) || { echo "invalid DMR ID" >&2; exit 2; }

case "$PORT" in
  /dev/serial0|/dev/ttyAMA[0-9]*|/dev/ttyS[0-9]*|/dev/ttyACM[0-9]*|/dev/ttyUSB[0-9]*|/dev/serial/by-id/*) ;;
  *) echo "unsupported modem port" >&2; exit 2 ;;
esac
[[ -e "$PORT" ]] || { echo "modem port does not exist: $PORT" >&2; exit 2; }

if [[ -r "$STATE/hardware-probe.json" ]] && ! grep -q '"detected"[[:space:]]*:[[:space:]]*true' "$STATE/hardware-probe.json"; then
  echo "MMDVM has not been identified; refusing RF apply" >&2
  exit 3
fi

mkdir -p /run "$STATE" "$BACKUPS" "$(dirname "$CONFIG")"
exec 9>"$LOCK"
flock -x 9

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
OLD=""
WAS_ACTIVE=0
if systemctl is-active --quiet "$SERVICE"; then WAS_ACTIVE=1; fi
if [[ -f "$CONFIG" ]]; then
  OLD="$BACKUPS/MMDVM-Host.ini.$STAMP"
  cp -a "$CONFIG" "$OLD"
fi

TMP=$(mktemp "$(dirname "$CONFIG")/.MMDVM-Host.ini.XXXXXX")
cleanup() { rm -f "$TMP"; }
trap cleanup EXIT

cat >"$TMP" <<EOF
[General]
Callsign=$CALLSIGN
Id=$DMRID
Timeout=180
Duplex=$DUPLEX
RFModeHang=10
NetModeHang=3
Daemon=0

[Log]
MQTTLevel=0
DisplayLevel=0

[CW Id]
Enable=0

[Modem]
Protocol=uart
UARTPort=$PORT
UARTSpeed=115200
RXFrequency=$RX
TXFrequency=$TX
TXInvert=0
RXInvert=0
PTTInvert=0
TXDelay=100
RXOffset=$RXOFF
TXOffset=$TXOFF
DMRDelay=0
RXLevel=50
TXLevel=50
RXDCOffset=0
TXDCOffset=0
RFLevel=100
UseCOSAsLockout=0
Trace=0
Debug=0

[D-Star]
Enable=0
Module=C

[DMR]
Enable=0
ColorCode=1
# Keep Talker Alias decoding available as soon as DMR is enabled by the DMR module.
# MMDVMHost receives/assembles the embedded TA blocks and logs the decoded alias.
DumpTAData=1

[System Fusion]
Enable=0

[P25]
Enable=0

[NXDN]
Enable=0

[POCSAG]
Enable=0

[FM]
Enable=0

[D-Star Network]
Enable=0

[DMR Network]
Enable=0

[System Fusion Network]
Enable=0

[P25 Network]
Enable=0

[NXDN Network]
Enable=0

[POCSAG Network]
Enable=0

[FM Network]
Enable=0

[Remote Control]
Enable=0
EOF

chmod 0640 "$TMP"
chown root:mmdvm "$TMP" 2>/dev/null || true
sync -f "$TMP" 2>/dev/null || true
mv -f "$TMP" "$CONFIG"
trap - EXIT

mkdir -p "$STATE"
printf '%s\n' "$STAMP" > "$STATE/rf-configured"

# 0.1.6 validates that MMDVMHost can own the modem and parse the RF configuration.
# Protocols and all networks remain disabled until the protocol/network module.
if ! systemctl enable --now "$SERVICE" >/dev/null 2>&1; then
  echo "MMDVMHost failed; rolling back RF configuration" >&2
  rm -f "$STATE/rf-configured"
  if [[ -n "$OLD" && -f "$OLD" ]]; then
    cp -a "$OLD" "$CONFIG"
    if (( WAS_ACTIVE )); then systemctl restart "$SERVICE" >/dev/null 2>&1 || true; fi
  else
    rm -f "$CONFIG"
    systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true
  fi
  exit 4
fi

sleep 1
if ! systemctl is-active --quiet "$SERVICE"; then
  echo "MMDVMHost did not stay active; rolling back RF configuration" >&2
  rm -f "$STATE/rf-configured"
  if [[ -n "$OLD" && -f "$OLD" ]]; then
    cp -a "$OLD" "$CONFIG"
    if (( WAS_ACTIVE )); then systemctl restart "$SERVICE" >/dev/null 2>&1 || true; fi
  else
    rm -f "$CONFIG"
    systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true
  fi
  exit 5
fi

printf 'RF_APPLY_OK rx=%s tx=%s rx_offset=%s tx_offset=%s duplex=%s port=%s\n' "$RX" "$TX" "$RXOFF" "$TXOFF" "$DUPLEX" "$PORT"
