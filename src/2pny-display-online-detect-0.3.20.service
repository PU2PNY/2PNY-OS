[Unit]
Description=PU2PNY bounded display detection after network connectivity
After=NetworkManager-wait-online.service network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/2pny-display-detector
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/2pny-display-online-detect
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/run/2pny /var/lib/2pny
[Install]
WantedBy=multi-user.target
